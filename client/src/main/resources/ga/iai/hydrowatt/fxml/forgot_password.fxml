<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" styleClass="auth-container" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ga.iai.hydrowatt.controller.ForgotPasswordController">
    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>

    <Label styleClass="title" text="Mot de passe oublié"/>
    <Label styleClass="subtitle" text="Un lien de réinitialisation à usage unique vous sera envoyé par email"/>

    <VBox maxWidth="320.0" spacing="10.0">
        <TextField fx:id="emailField" promptText="votre email"/>
        <Label fx:id="infoLabel" managed="false" styleClass="info-label" visible="false" wrapText="true"/>
        <Button fx:id="sendButton" defaultButton="true" onAction="#handleSend" styleClass="primary-button" text="Envoyer le lien"/>
        <Button onAction="#handleGoToReset" styleClass="secondary-button" text="J'ai déjà un token de réinitialisation"/>
        <Button onAction="#handleBack" styleClass="secondary-button" text="Retour à la connexion"/>
    </VBox>
</VBox>
