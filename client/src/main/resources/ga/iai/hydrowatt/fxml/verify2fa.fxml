<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" styleClass="auth-container" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ga.iai.hydrowatt.controller.Verify2FAController">
    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>

    <Label styleClass="title" text="Double authentification"/>
    <Label styleClass="subtitle" text="Saisissez le code à 6 chiffres de votre application d'authentification"/>

    <VBox maxWidth="280.0" spacing="10.0">
        <TextField fx:id="codeField" alignment="CENTER" promptText="000000"/>
        <Label fx:id="errorLabel" managed="false" styleClass="error-label" visible="false" wrapText="true"/>
        <Button fx:id="verifyButton" defaultButton="true" onAction="#handleVerify" styleClass="primary-button" text="Valider"/>
        <Button onAction="#handleCancel" styleClass="secondary-button" text="Annuler"/>
    </VBox>
</VBox>
