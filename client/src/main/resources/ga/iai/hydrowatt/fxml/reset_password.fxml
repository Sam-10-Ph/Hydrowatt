<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" styleClass="auth-container" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ga.iai.hydrowatt.controller.ResetPasswordController">
    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>

    <Label styleClass="title" text="Réinitialisation du mot de passe"/>
    <Label styleClass="subtitle" text="Collez le token reçu par email et choisissez un nouveau mot de passe"/>

    <VBox maxWidth="320.0" spacing="10.0">
        <TextField fx:id="tokenField" promptText="token reçu par email"/>
        <PasswordField fx:id="newPasswordField" promptText="nouveau mot de passe"/>
        <Label fx:id="infoLabel" managed="false" styleClass="info-label" visible="false" wrapText="true"/>
        <Button fx:id="resetButton" defaultButton="true" onAction="#handleReset" styleClass="primary-button" text="Réinitialiser"/>
        <Button onAction="#handleBack" styleClass="secondary-button" text="Retour à la connexion"/>
    </VBox>
</VBox>
